# Optional local settings; copy to .env and use absolute external paths.
AWS_ENDPOINT_URL=http://localhost:4566
# For a separate Floci instance in a NAT VM, choose its forwarded port.
# FLOCI_PORT=4567
# FLOCI_BIND_ADDRESS=0.0.0.0
# LESSON12_RUNTIME_DIR=/absolute/path/outside/repo/runtime
# LESSON12_EVIDENCE_DIR=/absolute/path/outside/repo/evidence
# Optional executable SSH wrapper accepting a single remote command (for bench).
# LESSON12_DOCKER_WRAPPER=/absolute/path/to/ssh-wrapper.sh
